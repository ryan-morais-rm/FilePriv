generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int       @id @default(autoincrement())
  nome     String    @db.VarChar(100)
  email    String    @unique @db.VarChar(100)
  senha    String    @db.VarChar(255)
  arquivos Arquivo[]

  @@map("usuarios")
}

enum StatusArquivo {
  PENDENTE   // Node recebeu, aguardando resposta do Rust
  CONCLUIDO  // Rust confirmou sucesso
  ERRO       // Rust reportou falha
  EXCLUINDO  // Node pediu exclusão ao Rust, aguardando confirmação
}

model Arquivo {
  id               Int           @id @default(autoincrement())
  nome_arquivo     String        @db.VarChar(255)
  descricao        String
  tipo_arquivo     String        @db.VarChar(10)
  status           StatusArquivo @default(PENDENTE)
  chave_referencia String?       @db.VarChar(255) // chave/caminho no bucket S3 — só preenchido quando CONCLUIDO
  servidor_id      Int?          // servidor onde o arquivo (inteiro) foi gravado
  tamanho          Int?          // bytes
  hash             String?       @db.VarChar(64)  // sha256 do arquivo, integridade
  usuario_id       Int
  data_upload      DateTime?     @default(now()) @db.Timestamp(6)
  usuario          Usuario       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  servidor         Servidor?     @relation(fields: [servidor_id], references: [id])

  @@map("arquivos")
}

model Servidor {
  id       Int       @id @default(autoincrement())
  host     String    @db.VarChar(255)
  porta    Int
  status   String    @default("ATIVO") @db.VarChar(20) // bandeira manual, não é health-check automático
  arquivos Arquivo[]

  @@map("servidores")
}