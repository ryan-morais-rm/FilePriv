generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int       @id @default(autoincrement())
  nome     String    @db.VarChar(100)
  email    String    @unique @db.VarChar(100)
  senha    String    @db.VarChar(255)
  arquivos Arquivo[]

  @@map("usuarios")
}

enum StatusArquivo {
  PENDENTE   // Node recebeu, aguardando resposta do Rust
  CONCLUIDO  // Rust confirmou sucesso
  ERRO       // Rust reportou falha
  EXCLUINDO  // Node pediu exclusão ao Rust, aguardando confirmação
}

model Arquivo {
  id               Int           @id @default(autoincrement())
  nome_arquivo     String        @db.VarChar(255)
  descricao        String
  tipo_arquivo     String        @db.VarChar(10)
  status           StatusArquivo @default(PENDENTE)
  chave_referencia String?       @db.VarChar(255) // caminho/chave da chave no bucket S3 — só preenchido quando status = CONCLUIDO
  usuario_id       Int
  data_upload      DateTime?     @default(now()) @db.Timestamp(6)
  usuario          Usuario       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  partes           Parte[]

  @@map("arquivos")
}

model Servidor {
  id     Int     @id @default(autoincrement())
  host   String  @db.VarChar(255)
  porta  Int
  status String  @default("ATIVO") @db.VarChar(20)
  partes Parte[]

  @@map("servidores")
}

model Parte {
  id          Int      @id @default(autoincrement())
  arquivo_id  Int
  servidor_id Int
  ordem       Int      // posição do chunk dentro do arquivo, necessário pra reconstrução
  tamanho     Int?     // bytes, opcional — útil pra validação e futura análise de carga
  hash        String?  @db.VarChar(64) // sha256 do chunk, opcional — checagem de integridade
  arquivo     Arquivo  @relation(fields: [arquivo_id], references: [id], onDelete: Cascade)
  servidor    Servidor @relation(fields: [servidor_id], references: [id])

  @@unique([arquivo_id, ordem])
  @@map("partes")
}